# Copy to server/.env and replace each placeholder locally.
# Do not commit server/.env or put backend secrets in client-side files.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
GEMINI_API_KEY=your-gemini-api-key
CLIENT_URL=http://localhost:5501/client
# Optional; defaults to http://localhost:5501/client in development.
# LOCAL_CLIENT_URL=http://localhost:5501/client
